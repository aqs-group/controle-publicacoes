# =============================================
# CONTROLE DE PUBLICAÇÕES — Environment Variables
# Copy to .env.local and fill in values
# DO NOT commit .env.local !
# =============================================

# --- Firebase Client (Frontend) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# --- Firebase Admin SDK (Backend) ---
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Option B: Base64-encoded service account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlI...

# --- Backend ---
BACKEND_URL=http://localhost:3001
BACKEND_PORT=3001
NODE_ENV=development

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# --- Emulator (local dev) ---
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Cloud Run (production) ---
# These are set automatically in Cloud Run environment
# GOOGLE_CLOUD_PROJECT=your-project-id
